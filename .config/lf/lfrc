set cursorpreviewfmt ""
set drawbox false
set errorfmt "\033[40;31m %s \033[0m"
set findlen 0
set hidden true
set icons false
set info size:time
set previewer scope
set scrolloff 8
set shell sh
set smartcase true
set statfmt "\033[44;30m %u \033[0m|\033[40;37m %p \033[0m| • %t|"
set timefmt "Monday 2 January 2006 at 15:04"
set truncatechar "•"

cmd bulk-rename $rename "$fx"
cmd chmod-x $printf '%s\n' "$fx" | xargs -d '\n' chmod -x --; lf -remote "send $id unselect"; lf -remote "send $id reload"
cmd chmodx $printf '%s\n' "$fx" | xargs -d '\n' chmod +x --; lf -remote "send $id unselect"; lf -remote "send $id reload"
cmd extract $extract "$f"
cmd mkdir $mkdir -p -- "$*"
cmd mounted-removeable-disk $target="/media/$USER"; [ -d "$target" ] || target="/media"; lf -remote "send $id cd \"$target\""
cmd open $riffle "$f"
cmd open-with $eval "$* \"\$f\""
cmd touch $touch -- "$*"
cmd yank-path $printf '%s' "$f" | { [ -n "$WAYLAND_DISPLAY" ] && wl-copy >/dev/null 2>&1 || xclip -selection clipboard >/dev/null 2>&1; }

map <enter> open
map <c-m> open
map <backspace> updir
map <backspace2> updir
map <c-h> updir
map o push :open-with<space>

map e $hx "$f"
map i $less "$f"

map <delete> delete
map <del> delete

map gE chmod-x
map gb bulk-rename
map gc cd ~/.config
map gd mounted-removeable-disk
map ge chmodx
map gh cd ~
map gm push :mkdir<space>
map gt push :touch<space>
map gx extract
map gy yank-path
